# Managed by chezmoi — 수정은 ~/Projects/machine-setup에서.
{{ if eq .chezmoi.os "linux" -}}
# Homebrew on Linux
[ -d /home/linuxbrew/.linuxbrew ] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ end -}}
# brew shellenv 가 Homebrew 를 PATH 맨 앞에 다시 붙인다 — venv·node@24 가 앞서는 순서로 되돌린다(정본 ~/.config/zsh/path.zsh)
source "$HOME/.config/zsh/path.zsh"

# oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="lambda"
plugins=(git sudo docker kubectl history colored-man-pages)
[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# History — oh-my-zsh(lib/history.zsh) 뒤에 둔다
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_FCNTL_LOCK HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY
unsetopt APPEND_HISTORY EXTENDED_HISTORY HIST_EXPIRE_DUPS_FIRST HIST_FIND_NO_DUPS HIST_IGNORE_ALL_DUPS HIST_SAVE_NO_DUPS

# Emacs keybindings
bindkey -e

# 환경변수·PATH 는 ~/.zshenv 와 ~/.config/zsh/path.zsh (비대화형 셸도 받도록)

# 가벼운 Emacs(다른 init 폴더 ~/.emacs.light.d)와 그 클라이언트
em() {
  local args=()
  for arg in "$@"; do
    case "$arg" in
      --daemon)    args+=("--daemon=em-server") ;;
      --daemon=*)  args+=("--daemon=em-${arg#--daemon=}") ;;
      *)           args+=("$arg") ;;
    esac
  done
  emacs --init-directory ~/.emacs.light.d "${args[@]}"
}
emc() {
  emacsclient -s em-server "$@"
}

alias e="emacsclient"
alias v="nvim"
alias ccc="claude --dangerously-skip-permissions"

{{ if .isWSL -}}
# --- WSL 전용 ---
# WSL에는 GUI 프로그램을 설치하지 않는다 — 링크/파일은 Windows 기본 앱으로 연다.
# (Linux 입력기·WSLg 관련 환경변수 불필요: 한글 입력은 Windows IME가 담당)
alias open="wslview"

# WSLg 그래픽 리디렉션 점검 — 기동 경합으로 use_gfxredir=0 이 되면 GUI 앱이 전부
# 작업표시줄 아이콘만 뜨고 창은 안 보인다. 배경·근거는 machine-setup의
# docs/troubleshooting.md 참고. 마지막 줄이 현재 상태다(재시작하면 줄이 늘어난다).
_wslg_gfxredir() {
  grep -oE 'use_gfxredir = [01]' /mnt/wslg/weston.log 2>/dev/null | tail -1 | awk '{print $NF}'
}
wslg-status() {
  case "$(_wslg_gfxredir)" in
    1) echo "WSLg: 정상 (use_gfxredir=1)" ;;
    0) echo "WSLg: 그래픽 리디렉션 꺼짐 (use_gfxredir=0) — 'wslg-fix' 실행" ;;
    *) echo "WSLg: 상태 불명 (/mnt/wslg/weston.log 없음)" ;;
  esac
}
wslg-fix() {
  wsl.exe --system -e pkill -x weston
  echo "weston 재시작 요청 — 열려 있던 GUI 창은 함께 닫힙니다."
}
# 부팅당 1회 경고. 자동 복구는 하지 않는다 — 열려 있는 GUI 창을 말없이 닫아 버린다.
if [ -r /mnt/wslg/weston.log ] && [ ! -e "${XDG_RUNTIME_DIR:-/tmp}/.wslg-checked" ]; then
  : > "${XDG_RUNTIME_DIR:-/tmp}/.wslg-checked" 2>/dev/null
  if [ "$(_wslg_gfxredir)" = 0 ]; then
    echo "!! WSLg 그래픽 리디렉션 꺼짐 — GUI 앱 창이 안 뜹니다. 'wslg-fix' 실행" >&2
  fi
fi
{{ end -}}

# rebuild: 저장소 pull + 적용 / update: 패키지 업그레이드 + rebuild
alias rebuild="chezmoi update"
{{ if eq .chezmoi.os "darwin" -}}
alias update="brew update && brew upgrade && brew upgrade --cask && chezmoi update"
{{ else -}}
alias update="sudo apt-get update && sudo apt-get upgrade -y && brew update && brew upgrade && chezmoi update"
{{ end -}}

# Shell integrations
command -v fzf >/dev/null 2>&1 && eval "$(fzf --zsh)"
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

{{ if eq .chezmoi.os "darwin" -}}
# iTerm2 shell integration (iterm2.com/shell_integration 로 따로 받은 스크립트가 있을 때만)
if [ "${TERM_PROGRAM:-}" = "iTerm.app" ] && [ -e "$HOME/.iterm2_shell_integration.zsh" ]; then
  source "$HOME/.iterm2_shell_integration.zsh"
fi
{{ end }}

# 개인 추가 설정 (있을 때만)
[ -f "$HOME/Projects/x/x.sh" ] && source "$HOME/Projects/x/x.sh"

# ERP10 개발 환경
[ -f "$HOME/.comet-env" ] && . "$HOME/.comet-env"

# 머신별·비공개 대화형 설정(저장소 밖, 있을 때만) — 회사 별칭·경로 등. 맨 끝이라 위 설정을 덮어쓸 수 있다
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
